modelName = 'tinyYOLOv2-coco';
helper.downloadPretrainedYOLOv2(modelName); pretrained =
load(modelName);
detector = pretrained.yolov2Detector;
%
while(1)
url = 'http://192.168.137.120/cam-mid.jpg'; I = imread(url); img =
imresize(I,[500,500]);
[boxes, scores, labels] = detect(detector, img);
% Visualize detection results.
img = insertObjectAnnotation(img,'rectangle',boxes,labels); str = string(labels); C = char(str);
tts(C);
imshow(img) end
